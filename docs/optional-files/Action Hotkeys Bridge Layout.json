{
  "name": "Action Hotkeys Bridge - Wheel Slot Layout Reset",
  "ini": "Data\\SKSE\\Plugins\\wheeler\\ActionHotkeysBridge.layout.ini",
  "data": [
    {
      "type": "text",
      "text": {
        "name": "How It Works",
        "desc": "This panel writes Wheel overrides directly to ActionHotkeysBridge.layout.ini. Set a slot to 0 to clear its persisted layout and let Wheeler auto-place it again on the next refresh."
      }
    },
    {
      "type": "text",
      "text": {
        "name": "Important",
        "desc": "This is a reset-oriented panel for the first 20 Action Hotkeys slots. Saving with every slot left at 0 behaves like a layout reset for the common auto-injection range."
      }
    },
    {
      "type": "group",
      "text": {
        "name": "Slots 1-20",
        "desc": "Set any slot to 0 to clear its saved wheel placement and let Wheeler auto-place it again."
      },
