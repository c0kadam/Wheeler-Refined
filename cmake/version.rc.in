#include <winres.h>

1 VERSIONINFO
	FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
	PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
	FILEFLAGSMASK 0x17L
#ifdef _DEBUG
	FILEFLAGS 0x1L
#else
	FILEFLAGS 0x0L
#endif
	FILEOS 0x4L
	FILETYPE 0x1L
	FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Wheeler Refined - Enhanced Wheeler Mod"
			VALUE "FileVersion", "@PROJECT_VERSION@.0"
			VALUE "InternalName", "@PROJECT_NAME@"
			VALUE "LegalCopyright", "Original Wheeler Copyright (c) 2024 dTry; Refined modifications by C0kadam and contributors"
			VALUE "ProductName", "Wheeler Refined"
			VALUE "ProductVersion", "@PROJECT_VERSION@.0"
			VALUE "CompanyName", "c0kadam"
			VALUE "Comments", "GPL-3.0-only; see LICENSE, NOTICE.md, and THIRD_PARTY_NOTICES.md"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
