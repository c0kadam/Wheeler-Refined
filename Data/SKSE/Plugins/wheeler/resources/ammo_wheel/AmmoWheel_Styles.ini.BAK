; ==============================================================================
; AmmoWheel Unified Reskin - Styles
; ==============================================================================
; Quickstart in 60 seconds:
; 1) Open Data\SKSE\Plugins\wheeler\AmmoWheel.ini
; 2) In [Reskin], set:
;      Enabled = true
;      BasePath = .\Data\SKSE\Plugins\wheeler\resources\ammo_wheel
; 3) Define presets in this file as [Preset_<ID>]
; 4) Map ammo to presets in AMMO_KID.ini
;
; NOTE:
; - ReskinUnified reads enable/base path from AmmoWheel.ini [Reskin]
; - This file is loaded from <BasePath>\AmmoWheel_Styles.ini
; - Optional modular files are loaded from <BasePath>\styles\*.ini (sorted by filename)
;
; ==============================================================================
; VisualTarget -> folder cheat sheet
; ==============================================================================
; WheelBackground   -> wheel_bg/
; WheelBorderRing  -> wheel_border/
;
; SlotBackground   -> slot_bg/
; SlotFrame        -> slot_frame/
; SlotDivider      -> slot_divider/
; SlotIcon         -> icons/
;
; IndicatorSelected -> indicators/selected/
; IndicatorHovered  -> indicators/hovered/
; IndicatorActive   -> indicators/active/
; IndicatorCharge   -> indicators/charge/
;
; CenterBackground  -> center_bg/
; CenterPanelFrame  -> center_frame/
;
; NamePanelBackground -> label_bg/
; CursorIndicator     -> cursor/
; LowAmmoIndicator    -> low_ammo/
;
; Popup            -> popup/
; PopupBubble      -> popup/bubble_fill/
; PopupBubbleRim   -> popup/bubble_rim/
; PopupBubbleGlow  -> popup/bubble_glow/
;
; DamageDigits    -> digits/
; MaxDamageDigits -> digits/
;
; AmmoCountDigits  -> digits/
;
; Static asset paths can be .png or .svg.
; Flipbooks are frame sequences (typically .png), using pattern syntax like {:02}.
;
; ==============================================================================
; Advanced optional keys (supported on every target prefix)
; ==============================================================================
; <Prefix>_RotationMode       : 0=FollowSlot, 1=Upright, 2=Fixed
; <Prefix>_RotationOffsetDeg  : extra rotation in degrees
; <Prefix>_FitMode            : 0=Contain(FitInsideSlot), 1=FixedSize
; <Prefix>_FixedSizePx        : used when FitMode=1
; <Prefix>_RotationSafetyScale: fit scale when FitMode=0
; <Prefix>_ProgressDriven     : flipbook frame uses DrawContext progress (opt-in)
; <Prefix>_IsAtlas            : sprite-sheet atlas mode (single texture + frame grid)
; <Prefix>_StartTimeMode      : 0=Global, 1=PerSlot, 2=PerEntry (for Flipbook/Atlas animation phase)
;
; AmmoCountDigits atlas keys:
; AmmoCountDigits_AtlasCols
; AmmoCountDigits_AtlasRows
; AmmoCountDigits_DigitSpacingPx
;
; Atlas animation keys (for targets like PopupBubble):
; <Prefix>_IsAtlas = true
; <Prefix>_Path = popup/my_effect_atlas.png
; <Prefix>_AtlasCols = 8
; <Prefix>_AtlasRows = 8
; <Prefix>_FrameCount = 60        ; optional, defaults to AtlasCols*AtlasRows
; <Prefix>_FPS = 24.0
; <Prefix>_Loop = true
; <Prefix>_ProgressDriven = false ; true => uses DrawContext.progress
; DamageDigits_AtlasCols / DamageDigits_AtlasRows / DamageDigits_DigitSpacingPx
; MaxDamageDigits_AtlasCols / MaxDamageDigits_AtlasRows / MaxDamageDigits_DigitSpacingPx
;																					
;
; ============================================================================
; Preset format
; ============================================================================
; Section name must be [Preset_<ID>]
; Example: [Preset_Default], [Preset_Blood], [Preset_MyTheme]
;
; Strict key ordering used below:
;   Metadata -> Wheel* -> Slot* -> Indicators* -> Center* ->
;   NamePanel/Cursor/LowAmmo -> Popup* -> Digits
;

[Preset_Default]
Name = Default
Description = Primitive fallback baseline

; Wheel*
WheelBackground_Enabled = true
WheelBackground_IsFlipbook = false
WheelBackground_Path = wheel_bg/wheel_background.svg
WheelBackground_Alpha = 0.8
WheelBorderRing_Enabled = true
WheelBorderRing_IsFlipbook = false
WheelBorderRing_Path = wheel_border/wheel_border.svg
WheelBorderRing_Alpha = 1.0

; Slot*
SlotBackground_Enabled = true
SlotFrame_Enabled = true
SlotFrame_IsFlipbook = false
SlotFrame_Path = slot_frame/slot_frame_arrow.svg
SlotFrame_Alpha = 1.0
SlotDivider_Enabled = true
SlotDivider_IsFlipbook = false
SlotDivider_Path = slot_divider/divider.svg
SlotDivider_Alpha = 0.3
SlotIcon_Enabled = false

; Indicators*
IndicatorSelected_Enabled = true
IndicatorSelected_IsFlipbook = false
IndicatorSelected_Path = indicators/selected/selected_ring.svg
IndicatorSelected_Alpha = 1.0
IndicatorHovered_Enabled = true
IndicatorHovered_IsFlipbook = false
IndicatorHovered_Path = indicators/hovered/hovered_ring.svg
IndicatorHovered_Alpha = 1.0
IndicatorActive_Enabled = true
IndicatorActive_IsFlipbook = false
IndicatorActive_Path = indicators/active/active_ring.svg
IndicatorActive_Alpha = 1.0
IndicatorCharge_Enabled = true
IndicatorCharge_IsFlipbook = false
IndicatorCharge_Path = indicators/charge/charge_ring.svg
IndicatorCharge_Alpha = 0.7

; Center*
CenterBackground_Enabled = true
CenterBackground_IsFlipbook = false
CenterBackground_Path = center_bg/center_background.svg
CenterBackground_Alpha = 0.85
CenterPanelFrame_Enabled = true
CenterPanelFrame_IsFlipbook = false
CenterPanelFrame_Path = center_frame/center_frame.svg
CenterPanelFrame_Alpha = 0.5

; NamePanel/Cursor/LowAmmo
NamePanelBackground_Enabled = true
NamePanelBackground_IsFlipbook = false
NamePanelBackground_Path = label_bg/name_panel_bg.svg
NamePanelBackground_Alpha = 1.0
NamePanelBackground_FitMode = 1
NamePanelBackground_FixedSizePx = 220.0
CursorIndicator_Enabled = true
CursorIndicator_IsFlipbook = false
CursorIndicator_Path = cursor/cursor_dot.svg
CursorIndicator_Alpha = 1.0
CursorIndicator_FitMode = 1
CursorIndicator_FixedSizePx = 10.0
LowAmmoIndicator_Enabled = true
LowAmmoIndicator_IsFlipbook = false
LowAmmoIndicator_Path = low_ammo/low_ammo_ring.svg
LowAmmoIndicator_Alpha = 1.0
LowAmmoIndicator_FitMode = 1
LowAmmoIndicator_FixedSizePx = 16.0

; Popup*
Popup_Enabled = true
Popup_IsFlipbook = false
Popup_Path = popup/popup_overlay.svg
Popup_Alpha = 1.0
PopupBubble_Enabled = false
PopupBubbleRim_Enabled = true
PopupBubbleRim_IsFlipbook = false
PopupBubbleRim_Path = popup/bubble_rim/bubble_rim.svg
PopupBubbleRim_Alpha = 1.0
PopupBubbleGlow_Enabled = true
PopupBubbleGlow_IsFlipbook = false
PopupBubbleGlow_Path = popup/bubble_glow/bubble_glow.svg
PopupBubbleGlow_Alpha = 0.3

; Digits
AmmoCountDigits_Enabled = true
AmmoCountDigits_IsFlipbook = false
AmmoCountDigits_Path = digits/digits_atlas.png
AmmoCountDigits_Alpha = 1.0
AmmoCountDigits_RotationMode = 1
AmmoCountDigits_FitMode = 1
AmmoCountDigits_FixedSizePx = 32.0
AmmoCountDigits_AtlasCols = 10
AmmoCountDigits_AtlasRows = 1
AmmoCountDigits_DigitSpacingPx = 1.0
DamageDigits_Enabled = true
DamageDigits_IsFlipbook = false
DamageDigits_Path = digits/damage_digits_atlas.png
DamageDigits_Alpha = 1.0
DamageDigits_RotationMode = 1
DamageDigits_FitMode = 1
DamageDigits_FixedSizePx = 32.0
DamageDigits_AtlasCols = 10
DamageDigits_AtlasRows = 1
DamageDigits_DigitSpacingPx = 1.0
MaxDamageDigits_Enabled = true
MaxDamageDigits_IsFlipbook = false
MaxDamageDigits_Path = digits/max_damage_digits_atlas.png
MaxDamageDigits_Alpha = 1.0
MaxDamageDigits_RotationMode = 1
MaxDamageDigits_FitMode = 1
MaxDamageDigits_FixedSizePx = 32.0
MaxDamageDigits_AtlasCols = 10
MaxDamageDigits_AtlasRows = 1
MaxDamageDigits_DigitSpacingPx = 1.0
